{
  "name": "@opencalque/desktop",
  "productName": "OpenCalque",
  "version": "1.6.0",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/preload",
    "smoke": "electron scripts/smoke.cjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@opencalque/cli": "workspace:*",
    "@opencalque/warehouse": "workspace:*",
    "@opencalque/web": "workspace:*",
    "@vitejs/plugin-react": "^5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "vite": "^7"
  },
  "description": "Open-source 2D architectural editor: floor plans and layouts.",
  "author": "OpenCalque contributors",
  "homepage": "https://github.com/laurent512/opencalque",
  "build": {
    "appId": "io.github.laurent512.opencalque",
    "productName": "OpenCalque",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      { "from": "../../LICENSE", "to": "LICENSE.txt" },
      { "from": "../../THIRD-PARTY-NOTICES.txt", "to": "THIRD-PARTY-NOTICES.txt" }
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "laurent512",
      "repo": "opencalque"
    },
    "fileAssociations": [
      {
        "ext": "opencalque",
        "name": "OpenCalque drawing",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OpenCalque-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "OpenCalque-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.graphics-design",
      "artifactName": "OpenCalque-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "executableName": "opencalque",
      "artifactName": "OpenCalque-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
