        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$",
            "description": "Unique name of the object type, prefixed by the extension, e.g. \"elec.socket\"."
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_]\\w*$"
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "number",
                    "boolean",
                    "string"
                  ]
                },
                "default": {
                  "type": [
                    "number",
                    "boolean",
                    "string"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unit": {
                  "description": "'length' marks a number as a length in mm, shown in the unit the user works in; 'angle' as an angle in degrees.",
                  "type": "string",
                  "enum": [
                    "length",
                    "angle"
                  ]
                }
              },
              "required": [
                "key",
                "label",
                "type",
                "default"
              ],
              "additionalProperties": false
            }
          },
          "opening": {
            "description": "Makes the object cut walls along this stretch of its X axis, like a door.",
            "type": "object",
            "properties": {
              "from": {
                "description": "A number, or an expression over the parameters such as \"width / 2\".",
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              },
              "to": {
                "description": "A number, or an expression over the parameters such as \"width / 2\".",
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "height": {
            "description": "How tall it stands on the floor, in mm, for elevations: furniture, appliances. An elevation draws it as a box of its width and this height, unless it has a \"front\".",
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "sill": {
            "description": "For an opening: the key of the length parameter that is how high above the floor it starts, as a window's sill. An elevation moves it up and down by it.",
            "type": "string"
          },
          "mount": {
            "description": "Makes the object go against the face of a wall: fixed on it at a height (\"on\": \"wall\", like a socket), or standing on the floor with its back against it (\"on\": \"floor\", like a kitchen unit). It is laid against the face nearest the pointer and follows the wall when the wall changes.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "on": {
                    "type": "string",
                    "const": "wall"
                  },
                  "back": {
                    "description": "The Y of its own laid along the face of the wall. Defaults to 0.",
                    "type": "number"
                  },
                  "out": {
                    "description": "Which way along its own Y it stands out of the wall: 'down' (+Y, the default) or 'up'.",
                    "type": "string",
                    "enum": [
                      "down",
                      "up"
                    ]
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "description": "How high above the floor it usually is, in mm, to its centre."
                  },
                  "measured": {
                    "description": "What its height is measured to: its centre (the default), or its underside ('bottom', a wall cabinet). Its front is drawn from that point.",
                    "type": "string",
                    "enum": [
                      "centre",
                      "bottom"
                    ]
                  }
                },
                "required": [
                  "on",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "on": {
                    "type": "string",
                    "const": "floor"
                  },
                  "back": {
                    "description": "The Y of its own laid along the face of the wall. Defaults to 0.",
