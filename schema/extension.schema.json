            "properties": {
              "x": {
                "type": "string"
              }
            },
            "required": [
              "x"
            ],
            "additionalProperties": false
          },
          "box": {
            "description": "The keys of the length parameters that are its width (along X) and height (along Y), the object filling the box from its insertion point to (width, height). It is then resized on the canvas by a frame, as a rectangle is: each side sets its parameter, in whole millimetres, and the knob above turns it.",
