          "category": {
            "description": "Where the component library lists it: a room (\"living\", \"dining\", \"bedroom\", \"office\"), \"bathroom\", \"kitchen\", \"electrical\", \"architecture\", \"annotation\", or a section of its own.",
            "type": "string"
          },
          "size": {
            "description": "The key of the length parameter that is its size along its X axis from the insertion point, such as a width. The object is then stretched on the canvas by the two ends of that size, rather than scaled.",
