  "objects": [
    {
      "kind": "elec.socket",
      "category": "electrical",
      "mount": { "on": "wall", "height": 300 },
      "label": "Socket",
      "description": "Placed beside a wall, it goes on its face. Several are side by side, or stacked one above the other.",
      "params": [
        { "key": "count", "label": "Count", "type": "number", "default": 1 },
        { "key": "layout", "label": "Arrangement", "type": "string", "default": "Side by side", "options": ["Side by side", "Stacked"] }
      ],
      "draw": [
        { "when": "layout != 'Stacked'", "repeat": { "count": "max(1, count)" }, "arc": { "cx": "i * 240", "cy": 0, "r": 100, "from": 0, "to": 180 } },
        { "when": "layout != 'Stacked'", "repeat": { "count": "max(1, count)" }, "path": [["i * 240 - 100", 0], ["i * 240 + 100", 0]] },
        { "when": "layout != 'Stacked'", "repeat": { "count": "max(1, count)" }, "path": [["i * 240", 100], ["i * 240", 190]] },
        { "when": "layout == 'Stacked'", "repeat": { "count": "max(1, min(count, 6))" }, "arc": { "cx": 0, "cy": 0, "r": "100 + i * 30", "from": 0, "to": 180 } },
        { "when": "layout == 'Stacked'", "path": [["-100 - (max(1, min(count, 6)) - 1) * 30", 0], ["100 + (max(1, min(count, 6)) - 1) * 30", 0]] },
        { "when": "layout == 'Stacked'", "path": [[0, "100 + (max(1, min(count, 6)) - 1) * 30"], [0, "190 + (max(1, min(count, 6)) - 1) * 30"]] }
      ],
      "front": [
        { "repeat": { "count": "max(1, count)" }, "path": [["layout == 'Stacked' ? -40 : i * 80 - 40", "layout == 'Stacked' ? -i * 80 - 40 : -40"], ["layout == 'Stacked' ? 40 : i * 80 + 40", "layout == 'Stacked' ? -i * 80 - 40 : -40"], ["layout == 'Stacked' ? 40 : i * 80 + 40", "layout == 'Stacked' ? -i * 80 + 40 : 40"], ["layout == 'Stacked' ? -40 : i * 80 - 40", "layout == 'Stacked' ? -i * 80 + 40 : 40"]], "closed": true, "radius": 8 },
        { "repeat": { "count": "max(1, count)" }, "ellipse": { "cx": "layout == 'Stacked' ? 0 : i * 80", "cy": "layout == 'Stacked' ? -i * 80 : 0", "rx": 22, "ry": 22 } },
        { "repeat": { "count": "max(1, count)" }, "ellipse": { "cx": "(layout == 'Stacked' ? 0 : i * 80) - 10", "cy": "layout == 'Stacked' ? -i * 80 : 0", "rx": 3.5, "ry": 3.5 } },
        { "repeat": { "count": "max(1, count)" }, "ellipse": { "cx": "(layout == 'Stacked' ? 0 : i * 80) + 10", "cy": "layout == 'Stacked' ? -i * 80 : 0", "rx": 3.5, "ry": 3.5 } }
      ]
    },
    {
      "kind": "elec.switch",
      "category": "electrical",
      "mount": { "on": "wall", "back": 60, "out": "up", "height": 1100 },
      "label": "Switch",
      "params": [
        { "key": "twoWay", "label": "Two-way", "type": "boolean", "default": false },
        { "key": "double", "label": "Two circuits", "type": "boolean", "default": false }
      ],
      "draw": [
        { "ellipse": { "cx": 0, "cy": 0, "rx": 60, "ry": 60 } },
        { "path": [[42, -42], [180, -180], [230, -130]] },
        { "when": "twoWay", "path": [[-42, 42], [-180, 180], [-230, 130]] },
        { "when": "double", "path": [[130, -130], [180, -80]] }
      ],
      "front": [
        { "path": [[-40, -40], [40, -40], [40, 40], [-40, 40]], "closed": true, "radius": 8 },
        { "path": [[-15, -25], [15, -25], [15, 25], [-15, 25]], "closed": true, "radius": 3, "when": "!double" },
        { "when": "double", "path": [[-32, -25], [-4, -25], [-4, 25], [-32, 25]], "closed": true, "radius": 3 },
        { "when": "double", "path": [[4, -25], [32, -25], [32, 25], [4, 25]], "closed": true, "radius": 3 }
      ]
    },
    {
      "kind": "elec.light",
      "category": "electrical",
      "label": "Ceiling light",
      "params": [{ "key": "size", "label": "Size", "type": "number", "default": 240, "unit": "length" }],
      "draw": [
        { "ellipse": { "cx": 0, "cy": 0, "rx": "size / 2", "ry": "size / 2" } },
        { "path": [["-size * 0.354", "-size * 0.354"], ["size * 0.354", "size * 0.354"]] },
        { "path": [["-size * 0.354", "size * 0.354"], ["size * 0.354", "-size * 0.354"]] }
      ]
    },
    {
      "kind": "elec.walllight",
      "category": "electrical",
