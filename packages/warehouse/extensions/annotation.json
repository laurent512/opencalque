    "zh": {
      "Plan annotations": "平面图标注",
      "North arrow, scale bar and level marker.": "指北针、比例尺和标高符号。",
      "North arrow": "指北针",
      "Scale bar": "比例尺",
      "Level marker": "标高符号",
      "Size": "大小",
      "Length": "长度",
      "Divisions": "分段数",
      "Level": "标高",
      "Text size": "文字大小"
    },
    "ja": {
      "Plan annotations": "図面記号",
      "North arrow, scale bar and level marker.": "方位記号、スケールバー、レベル記号。",
      "North arrow": "方位記号",
      "Scale bar": "スケールバー",
      "Level marker": "レベル記号",
      "Size": "サイズ",
      "Length": "長さ",
      "Divisions": "分割数",
      "Level": "レベル",
      "Text size": "文字サイズ"
    },
    "ko": {
      "Plan annotations": "도면 기호",
      "North arrow, scale bar and level marker.": "방위표, 축척 막대, 레벨 기호.",
      "North arrow": "방위표",
      "Scale bar": "축척 막대",
      "Level marker": "레벨 기호",
      "Size": "크기",
      "Length": "길이",
      "Divisions": "눈금 수",
      "Level": "레벨",
      "Text size": "글자 크기"
    },
    "tr": {
      "Plan annotations": "Plan açıklamaları",
      "North arrow, scale bar and level marker.": "Kuzey oku, ölçek çubuğu ve kot işareti.",
      "North arrow": "Kuzey oku",
      "Scale bar": "Ölçek çubuğu",
      "Level marker": "Kot işareti",
      "Size": "Boyut",
      "Length": "Uzunluk",
      "Divisions": "Bölmeler",
      "Level": "Kot",
      "Text size": "Metin boyutu"
    }
  },
  "objects": [
    {
      "kind": "note.north",
      "category": "annotation",
      "label": "North arrow",
      "params": [{ "key": "size", "label": "Size", "type": "number", "default": 800, "unit": "length" }],
      "draw": [
        { "ellipse": { "cx": 0, "cy": 0, "rx": "size / 2", "ry": "size / 2" } },
        { "closed": true, "fill": "#1f1f1f", "path": [[0, "-size / 2"], ["size * 0.17", "size * 0.33"], [0, "size * 0.18"], ["-size * 0.17", "size * 0.33"]] },
        { "text": { "x": 0, "y": "-size * 0.58", "value": "N", "size": "size * 0.3", "align": "center" } }
      ]
    },
    {
      "kind": "note.scalebar",
      "category": "annotation",
      "label": "Scale bar",
      "params": [
        { "key": "length", "label": "Length", "type": "number", "default": 5000, "unit": "length" },
        { "key": "divisions", "label": "Divisions", "type": "number", "default": 5 },
        { "key": "textSize", "label": "Text size", "type": "number", "default": 150, "unit": "length" }
      ],
      "draw": [
        { "closed": true, "path": [[0, 0], ["length", 0], ["length", -100], [0, -100]] },
        {
          "repeat": { "count": "max(1, divisions)" },
          "when": "i % 2 == 0",
          "closed": true,
          "fill": "#1f1f1f",
          "path": [
            ["i * length / max(1, divisions)", 0],
            ["(i + 1) * length / max(1, divisions)", 0],
            ["(i + 1) * length / max(1, divisions)", -100],
            ["i * length / max(1, divisions)", -100]
          ]
        },
        { "text": { "x": 0, "y": "-100 - textSize * 0.4", "value": "0", "size": "textSize", "align": "center" } },
        { "text": { "x": "length", "y": "-100 - textSize * 0.4", "value": "{length / 1000} m", "size": "textSize", "align": "center" } }
      ]
    },
    {
      "kind": "note.level",
      "category": "annotation",
      "label": "Level marker",
      "params": [
        { "key": "level", "label": "Level", "type": "string", "default": "+0.00" },
        { "key": "size", "label": "Size", "type": "number", "default": 200, "unit": "length" }
      ],
      "draw": [
        { "closed": true, "path": [[0, 0], ["size * 0.6", "-size"], ["-size * 0.6", "-size"]] },
        { "path": [["-size * 0.6", "-size"], ["size * 3.2", "-size"]] },
        { "text": { "x": "size * 0.8", "y": "-size * 1.15", "value": "{level}", "size": "size * 0.8" } }
      ]
    }
  ]
}
